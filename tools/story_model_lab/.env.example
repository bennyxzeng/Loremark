# Copy to .env in this folder and fill in the values; run_story_model.py loads it (.env is
# gitignored). The story-model command itself reads only variables exported in your shell.
# run_story_model.py always passes the model, so *_MODEL is only needed for story-model.

# OpenAI (gpt-6.1-terra; story-model --provider openai, the default)
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=

# DeepSeek (deepseek-flash; story-model --provider deepseek)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=

# Live smoke tests (pytest -m live)
RUN_LIVE_OPENAI=
RUN_LIVE_DEEPSEEK=
