# Names of the environment variables story-model reads. This file is documentation only:
# the tool never loads it. Export the values in your shell instead.

# --provider openai (default)
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=

# --provider deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=

# Live smoke tests (pytest -m live)
RUN_LIVE_OPENAI=
RUN_LIVE_DEEPSEEK=
